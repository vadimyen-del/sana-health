{
  "expo": {
    "name": "SANA Health",
    "slug": "sana-health",
    "scheme": "sanahealth",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kz.sanahealth.app"
    },
    "android": {
      "package": "kz.sanahealth.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
